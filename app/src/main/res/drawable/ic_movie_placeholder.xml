<?xml version="1.0" encoding="utf-8"?>
<!-- Affiche par défaut au format 2:3 : fond plein + icône film centrée.
     Conçu pour scaleType=centerCrop sans déformation ni effet "trop grand". -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="200dp"
    android:height="300dp"
    android:viewportWidth="200"
    android:viewportHeight="300">

    <!-- Fond plein occupant toute l'affiche -->
    <path
        android:fillColor="#252535"
        android:pathData="M0,0 L200,0 L200,300 L0,300 Z" />

    <!-- Icône film (clap) centrée, mise à l'échelle x3 (72x72) -->
    <group
        android:translateX="64"
        android:translateY="114"
        android:scaleX="3"
        android:scaleY="3">
        <path
            android:fillColor="#3A3A5C"
            android:pathData="M18,4l2,4h-3l-2,-4h-2l2,4h-3l-2,-4H8l2,4H7L5,4H4c-1.1,0 -1.99,0.9 -1.99,2L2,18c0,1.1 0.9,2 2,2h16c1.1,0 2,-2 2,-2V4h-4z" />
    </group>
</vector>
