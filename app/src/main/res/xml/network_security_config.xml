<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- App grand public : la source (M3U ou Xtream Codes) est fournie par
         l'utilisateur, hébergée sur un serveur IPTV tiers quelconque — la grande
         majorité sont en HTTP simple (pas de certificat). Cleartext autorisé
         globalement, contrairement à NicoTV (hôtes fixes, tout en HTTPS). -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
