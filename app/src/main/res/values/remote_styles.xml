<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Styles de RemoteControlActivity : boutons ronds plats (au lieu du Button
         Material gris par défaut, incident 2026-08-03 « présentation pourrie »),
         même esprit visuel que les boutons circulaires de la PWA (.rc-round/.rc-d). -->
    <style name="RemoteCircleBtn">
        <item name="android:layout_width">54dp</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:background">@drawable/bg_circle_btn</item>
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">-2sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="RemoteCircleBtnAccent" parent="RemoteCircleBtn">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:background">@drawable/bg_circle_btn_accent</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <!-- Version FrameLayout (icône ImageView dedans, pas de texte) de RemoteCircleBtn/
         RemoteCircleBtnAccent — remplace les boutons emoji "moches" (incident
         2026-08-04) par de vraies icônes vectorielles, mêmes que la PWA. -->
    <style name="RemoteIconBtn">
        <item name="android:layout_width">54dp</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:background">@drawable/bg_circle_btn</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="RemoteIconBtnAccent" parent="RemoteIconBtn">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:background">@drawable/bg_circle_btn_accent</item>
    </style>

    <style name="RemoteDpadBtn">
        <item name="android:layout_width">58dp</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:background">@drawable/bg_circle_btn</item>
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- OK au centre de la molette : sombre (bg_circle_btn_ok), pas bleu accent —
         cf. bg_wheel_circle.xml, même contraste que la référence photo. -->
    <style name="RemoteDpadBtnAccent" parent="RemoteDpadBtn">
        <item name="android:background">@drawable/bg_circle_btn_ok</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Flèches posées directement sur le disque unique (bg_wheel_circle), pas de
         cercle individuel par flèche — même esprit que la molette de référence
         (photo) : un seul disque, juste un halo au clic (ripple sans fond visible
         au repos), OK reste le seul vrai cercle plein au centre. -->
    <style name="RemoteWheelBtn">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">64dp</item>
        <!-- ?android:attr (PAS ?attr, un attribut AppCompat non garanti résolu sous
             Theme.Leanback) : plantait à l'inflation du layout — "lateinit property
             binding has not been initialized" ensuite, le vrai crash était ICI
             (incident 2026-08-04, stack trace fournie). -->
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">24sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="RemotePill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_remote_pill</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="RemoteTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
