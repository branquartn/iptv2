<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        app:show_subtitle_button="false"
        app:controller_layout_id="@layout/player_control_view" />

    <ProgressBar
        android:id="@+id/progress_buffering"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accent"
        android:visibility="gone" />

    <!-- Overlay pause : logo + titre (fond transparent) -->
    <LinearLayout
        android:id="@+id/overlay_pause_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="72dp"
        android:layout_marginBottom="110dp"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitStart"
            android:src="@drawable/ic_nicotv_wordmark" />

        <TextView
            android:id="@+id/tv_pause_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@android:color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="6" />

        <TextView
            android:id="@+id/tv_pause_episode_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#DDDDDD"
            android:textSize="16sp"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Icônes haut-gauche : retour + reprendre à zéro + épisode suivant -->
    <LinearLayout
        android:id="@+id/overlay_top_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="16dp"
        android:layout_marginStart="20dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:padding="8dp"
            android:src="@drawable/ic_pwa_back"
            android:tint="@color/player_icon_tint"
            android:background="@android:color/transparent"
            android:contentDescription="Retour"
            android:focusable="true"
            android:scaleType="fitCenter" />

        <!-- Déclenchement manuel du PiP : le bouton retour arrière-plan du téléphone
             (onUserLeaveHint) ne le déclenche pas de façon fiable partout (variable
             selon navigation gestuelle/OEM) — bouton dédié en filet. -->
        <ImageButton
            android:id="@+id/btn_pip"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:padding="8dp"
            android:src="@drawable/ic_pip"
            android:tint="@color/player_icon_tint"
            android:background="@android:color/transparent"
            android:contentDescription="Picture-in-picture"
            android:focusable="true"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_restart"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:padding="8dp"
            android:src="@drawable/ic_pwa_restart"
            android:tint="@color/player_icon_tint"
            android:background="@android:color/transparent"
            android:contentDescription="Reprendre à zéro"
            android:focusable="true"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_next_episode"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_player_skip_next"
            android:tint="@color/player_icon_tint"
            android:background="@android:color/transparent"
            android:contentDescription="Épisode suivant"
            android:focusable="true"
            android:scaleType="fitCenter"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Prompt épisode suivant : apparaît en fin de générique (heuristique = derniers
         instants du fichier), compte à rebours 5s avant enchaînement automatique. -->
    <LinearLayout
        android:id="@+id/overlay_next_episode"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="90dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_dialog"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_next_episode_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_next_episode_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_next_episode_play"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lire maintenant"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_btn_secondary" />

            <TextView
                android:id="@+id/btn_next_episode_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Annuler"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_btn_secondary" />

        </LinearLayout>

    </LinearLayout>

    <!-- Panel paramètres style sous-menu (deux niveaux) -->
    <LinearLayout
        android:id="@+id/panel_settings"
        android:layout_width="270dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="64dp"
        android:orientation="vertical"
        android:background="#F0111111"
        android:visibility="gone">

        <!-- Niveau 1 : liste des paramètres -->
        <LinearLayout
            android:id="@+id/menu_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Vitesse -->
            <LinearLayout
                android:id="@+id/row_speed"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_btn_secondary">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Vitesse"
                    android:textColor="@android:color/white"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_speed_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Normal"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="›"
                    android:textColor="#666666"
                    android:textSize="18sp" />

            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#222222" />

            <!-- Piste audio -->
            <LinearLayout
                android:id="@+id/row_audio"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_btn_secondary">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Piste audio"
                    android:textColor="@android:color/white"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_audio_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="›"
                    android:textColor="#666666"
                    android:textSize="18sp" />

            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#222222" />

            <!-- Sous-titres -->
            <LinearLayout
                android:id="@+id/row_subtitles"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_btn_secondary">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sous-titres"
                    android:textColor="@android:color/white"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_subtitle_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Désactivé"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="›"
                    android:textColor="#666666"
                    android:textSize="18sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Niveau 2 : sous-sélection -->
        <LinearLayout
            android:id="@+id/menu_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- En-tête retour + titre -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="16dp"
                android:background="#1A1A1A">

                <ImageButton
                    android:id="@+id/btn_sub_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_pwa_back"
                    android:tint="@color/player_icon_tint"
                    android:background="@android:color/transparent"
                    android:contentDescription="Retour"
                    android:focusable="true"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/tv_sub_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#333333" />

            <!-- Options (remplies dynamiquement) -->
            <LinearLayout
                android:id="@+id/container_sub_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </LinearLayout>


</FrameLayout>
