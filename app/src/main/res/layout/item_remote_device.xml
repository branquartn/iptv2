<?xml version="1.0" encoding="utf-8"?>
<!-- Ligne du sélecteur d'appareil de la télécommande. Remplace
     android.R.layout.simple_spinner_dropdown_item, dont les lignes sont trop basses
     et trop serrées : avec deux sessions listées, viser la bonne au doigt était
     difficile (demande utilisateur). -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:textColor="@color/text_primary"
    android:textSize="16sp"
    android:background="?android:attr/selectableItemBackground" />
