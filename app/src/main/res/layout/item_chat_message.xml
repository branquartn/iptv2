<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:id="@+id/bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:foreground="@drawable/chat_focus_bubble"
        android:minWidth="64dp"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp">

        <!-- « Transféré de … » -->
        <TextView
            android:id="@+id/tv_fwd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:textColor="#3390EC"
            android:textSize="11.5sp"
            android:visibility="gone" />

        <!-- Citation : barre colorée + auteur + extrait -->
        <LinearLayout
            android:id="@+id/quote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal"
            android:visibility="gone">

            <View
                android:id="@+id/quote_bar"
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="#3390EC" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_q_who"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#111318"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_q_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.85"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#111318"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_image"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:adjustViewBounds="true"
            android:maxHeight="260dp"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- Vocal : bouton rond + jauge -->
        <LinearLayout
            android:id="@+id/voice_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minWidth="190dp"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_voice_play"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="10dp"
                android:src="@drawable/ic_chat_play"
                android:tint="@android:color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <View
                    android:id="@+id/voice_bar"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="#29000000" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Message vocal"
                    android:textColor="#8A8F95"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Fichier -->
        <LinearLayout
            android:id="@+id/file_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_filebox"
            android:gravity="center_vertical"
            android:minWidth="160dp"
            android:orientation="horizontal"
            android:padding="9dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_chat_filebox"
                android:padding="7dp"
                android:src="@drawable/ic_chat_paperclip"
                android:tint="#111318" />

            <TextView
                android:id="@+id/tv_file_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#111318"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Film partagé : jaquette + titre + année -->
        <LinearLayout
            android:id="@+id/film_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="200dp"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_film_poster"
                android:layout_width="58dp"
                android:layout_height="87dp"
                android:background="@drawable/bg_chat_poster_ph"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical"
                android:paddingTop="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎬 FILM"
                    android:textColor="#3390EC"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_film_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="#111318"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_film_year"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="#8A8F95"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.1"
            android:textColor="#111318"
            android:textSize="15.5sp" />

        <!-- Heure + double coche (envoyés) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#8A8F95"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_tick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="✓✓"
                android:textColor="#5CB85C"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Réaction collée sous le contenu -->
        <TextView
            android:id="@+id/tv_react"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
