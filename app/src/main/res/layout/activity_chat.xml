<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chat_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fil de messages : défile SOUS l'en-tête et la barre de saisie (translucides), comme la PWA -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_chat"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="8dp"
        android:paddingTop="76dp"
        android:paddingEnd="8dp"
        android:paddingBottom="76dp"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/tv_chat_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="32dp"
        android:shadowColor="#55000000"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:text="Pas encore de message."
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- En-tête : retour · pilule (avatar, titre, loupe, ⋮) -->
    <LinearLayout
        android:id="@+id/chat_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageView
            android:id="@+id/btn_chat_back"
            android:foreground="@drawable/chat_focus_round"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_chat_circle_white"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_chat_back"
            android:tint="#111318" />

        <LinearLayout
            android:id="@+id/chat_head_pill"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chat_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="5dp"
            android:paddingEnd="2dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_chat_avatar"
                android:padding="8dp"
                android:src="@drawable/ic_chat"
                android:tint="@android:color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tchat IPTV"
                    android:textColor="#111318"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="bot"
                    android:textColor="#707579"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btn_chat_search"
            android:foreground="@drawable/chat_focus_round"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_chat_search"
                android:tint="#707579" />

            <ImageView
                android:id="@+id/btn_chat_menu"
            android:foreground="@drawable/chat_focus_round"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_chat_dots"
                android:tint="#707579" />
        </LinearLayout>
    </LinearLayout>

    <!-- Barre de recherche : remplace l'en-tête -->
    <LinearLayout
        android:id="@+id/chat_search_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/btn_chat_search_close"
            android:foreground="@drawable/chat_focus_round"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_chat_circle_white"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_chat_back"
            android:tint="#111318" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chat_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="14dp">

            <EditText
                android:id="@+id/et_chat_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Rechercher"
                android:imeOptions="flagNoExtractUi|actionSearch"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="#111318"
                android:textColorHint="#707579"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_chat_search_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#707579"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bas : bandeau réponse / modification + barre de saisie -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/chat_reply_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chat_in"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="4dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <View
                android:layout_width="3dp"
                android:layout_height="34dp"
                android:background="#3390EC" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_reply_who"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#3390EC"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_reply_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#707579"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btn_reply_cancel"
            android:foreground="@drawable/chat_focus_round"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp"
                android:src="@drawable/ic_chat_close"
                android:tint="#707579" />
        </LinearLayout>

        <!-- Bandeau « modification » (visible seulement pendant l'édition d'un message) -->
        <TextView
            android:id="@+id/tv_edit_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chat_in"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:text="✎ Modification du message — appuie ici pour annuler"
            android:textColor="#707579"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Saisie : pilule translucide (emoji · champ · trombone · micro/envoi) -->
        <LinearLayout
            android:id="@+id/chat_input_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chat_pill"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:id="@+id/btn_chat_emoji"
            android:foreground="@drawable/chat_focus_round"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="9dp"
                    android:src="@drawable/ic_chat_smile"
                    android:tint="#707579" />

                <EditText
                    android:id="@+id/et_chat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Message"
                    android:imeOptions="flagNoExtractUi"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="4"
                    android:minHeight="44dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textColor="#111318"
                    android:textColorHint="#707579"
                    android:textSize="16sp" />

                <ImageView
                    android:id="@+id/btn_chat_attach"
            android:foreground="@drawable/chat_focus_round"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="9dp"
                    android:src="@drawable/ic_chat_paperclip"
                    android:tint="#707579" />

                <ImageView
                    android:id="@+id/btn_chat_action"
            android:foreground="@drawable/chat_focus_round"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="9dp"
                    android:src="@drawable/ic_chat_mic" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Bouton flottant « revenir au dernier message » -->
    <ImageView
        android:id="@+id/btn_chat_jump"
            android:foreground="@drawable/chat_focus_round"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="84dp"
        android:background="@drawable/bg_chat_circle_white"
        android:clickable="true"
        android:focusable="true"
        android:padding="12dp"
        android:rotation="90"
        android:src="@drawable/ic_chat_chevron"
        android:visibility="gone"
        android:tint="#707579" />
</FrameLayout>
