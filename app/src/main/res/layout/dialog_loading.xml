<?xml version="1.0" encoding="utf-8"?>
<!-- Rond de chargement au milieu de l'écran, générique (29/08/2026, demande
     explicite : "au milieu pas en bas... indique chargement en cours") —
     remplace un petit ProgressBar sans texte perdu en bas du formulaire.
     Même style que dialog_update_progress.xml (fond bg_dialog sur la vue
     elle-même, fenêtre du dialogue mise en transparent côté Kotlin). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog"
    android:gravity="center_horizontal"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingTop="32dp"
    android:paddingBottom="32dp">

    <ProgressBar
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:indeterminateTint="@color/accent" />

    <TextView
        android:id="@+id/tv_loading_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/setup_loading_in_progress"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
