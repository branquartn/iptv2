<?xml version="1.0" encoding="utf-8"?>
<!-- Contenu du dialogue "Charger votre playlist" (carte Playlist sur l'écran
     de démarrage) — affiché centré via AlertDialog au lieu de s'étaler sous
     les cartes de choix. ScrollView : cf. commentaire équivalent dans
     dialog_form_xtream.xml (clavier + paysage = bouton hors zone visible). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="320dp"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <EditText
        android:id="@+id/et_playlist_name"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_input"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:hint="@string/setup_name_hint"
        android:textColor="@android:color/white"
        android:textColorHint="@color/text_secondary"
        android:maxLines="1"
        android:singleLine="true" />

    <EditText
        android:id="@+id/et_m3u_url"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:hint="@string/setup_url_hint"
        android:textColor="@android:color/white"
        android:textColorHint="@color/text_secondary"
        android:inputType="textUri"
        android:maxLines="1"
        android:singleLine="true" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/setup_or"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btn_pick_file"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_btn_secondary"
        android:text="@string/setup_file_pick"
        android:textAllCaps="false"
        android:textColor="@android:color/white" />

    <TextView
        android:id="@+id/tv_file_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_load_playlist"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_btn_primary"
        android:text="@string/action_load"
        android:textAllCaps="false"
        android:textColor="@android:color/white" />

</LinearLayout>
</ScrollView>
