<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical">

    <!-- Barre du haut -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <FrameLayout
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="20dp"
            android:focusable="true"
            android:clickable="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:defaultFocusHighlightEnabled="false">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_pwa_back"
                android:layout_gravity="center" />

            <com.nicotv.iptv.ui.common.RotatingBorderView
                android:id="@+id/btn_back_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="3dp"
                app:circular="true"
                app:borderColor="@android:color/white"
                android:visibility="invisible" />

        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Télécommande"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <!-- Aucune autre session -->
            <TextView
                android:id="@+id/tv_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="Aucune autre session active pour le moment."
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:visibility="gone" />

            <!-- Sélecteur d'appareil (si plusieurs sessions) -->
            <Spinner
                android:id="@+id/sp_device"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_remote_card"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="10dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_target"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_remote_card"
                android:padding="14dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="18dp"
                android:visibility="gone" />

            <!-- Contrôles lecteur (visibles seulement si l'appareil ciblé regarde un film) -->
            <LinearLayout
                android:id="@+id/row_player"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_remote_card"
                android:padding="18dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <FrameLayout android:id="@+id/btn_seek_back" style="@style/RemoteIconBtn">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center"
                        android:src="@drawable/ic_pwa_back" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="6dp"
                        android:text="10s" android:textColor="@android:color/white" android:textSize="9sp" android:textStyle="bold" />
                </FrameLayout>

                <FrameLayout android:id="@+id/btn_play_pause" style="@style/RemoteIconBtnAccent"
                    android:layout_marginStart="16dp" android:layout_marginEnd="16dp">
                    <ImageView android:id="@+id/iv_play_pause" android:layout_width="22dp" android:layout_height="22dp"
                        android:layout_gravity="center" android:src="@drawable/ic_pwa_play" />
                </FrameLayout>

                <FrameLayout android:id="@+id/btn_seek_fwd" style="@style/RemoteIconBtn">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center"
                        android:scaleX="-1" android:src="@drawable/ic_pwa_back" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="6dp"
                        android:text="10s" android:textColor="@android:color/white" android:textSize="9sp" android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_player2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_remote_card"
                android:padding="18dp"
                android:layout_marginBottom="24dp"
                android:visibility="gone">

                <FrameLayout android:id="@+id/btn_mute" style="@style/RemoteIconBtn">
                    <ImageView android:id="@+id/iv_mute" android:layout_width="20dp" android:layout_height="20dp"
                        android:layout_gravity="center" android:src="@drawable/ic_pwa_vol" />
                </FrameLayout>

                <SeekBar
                    android:id="@+id/sb_volume"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:max="100"
                    android:progress="100"
                    android:progressTint="@color/accent"
                    android:thumbTint="@color/accent" />

                <FrameLayout android:id="@+id/btn_audio" style="@style/RemoteIconBtn">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center"
                        android:src="@drawable/ic_pwa_vol" />
                </FrameLayout>

                <FrameLayout android:id="@+id/btn_subtitle" style="@style/RemoteIconBtn" android:layout_marginStart="12dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center"
                        android:src="@drawable/ic_player_subtitles" />
                </FrameLayout>
            </LinearLayout>

            <!-- Onglet D-pad -->
            <LinearLayout
                android:id="@+id/dpad_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/bg_remote_card"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="32dp"
                android:paddingBottom="32dp">

                <!-- Molette : UN disque plein (bg_wheel_circle) avec les 4 flèches
                     posées dessus par position (haut/bas/gauche/droite) + OK au centre
                     — pas 5 cercles séparés, pour coller à la référence (photo).
                     Taille dans dimens.xml : sur un écran étroit, 260dp + les paddings
                     du ScrollView et de la carte dépassaient la largeur dispo et le
                     disque était rogné à gauche/droite. -->
                <FrameLayout
                    android:layout_width="@dimen/remote_wheel_size"
                    android:layout_height="@dimen/remote_wheel_size"
                    android:background="@drawable/bg_wheel_circle">

                    <TextView android:id="@+id/btn_nav_up" style="@style/RemoteWheelBtn"
                        android:layout_gravity="top|center_horizontal" android:layout_marginTop="14dp"
                        android:text="▲" />

                    <TextView android:id="@+id/btn_nav_down" style="@style/RemoteWheelBtn"
                        android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="14dp"
                        android:text="▼" />

                    <TextView android:id="@+id/btn_nav_left" style="@style/RemoteWheelBtn"
                        android:layout_gravity="start|center_vertical" android:layout_marginStart="14dp"
                        android:text="◀" />

                    <TextView android:id="@+id/btn_nav_right" style="@style/RemoteWheelBtn"
                        android:layout_gravity="end|center_vertical" android:layout_marginEnd="14dp"
                        android:text="▶" />

                    <TextView android:id="@+id/btn_nav_ok" style="@style/RemoteDpadBtnAccent"
                        android:layout_gravity="center" android:layout_width="76dp" android:layout_height="76dp"
                        android:text="OK" />

                </FrameLayout>

                <TextView
                    android:id="@+id/btn_nav_back"
                    style="@style/RemotePill"
                    android:layout_marginTop="22dp"
                    android:text="↩  Retour" />

            </LinearLayout>

            <!-- Onglet Souris : pavé tactile, curseur virtuel déplacé sur l'appareil
                 ciblé (mouse_move/mouse_click), même mécanisme que le D-pad
                 (IptvApplication.handleMouseMove/handleMouseClick, parité PWA). -->
            <FrameLayout
                android:id="@+id/mouse_content"
                android:layout_width="match_parent"
                android:layout_height="@dimen/remote_touchpad_height"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/touchpad"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_dashed_trackpad"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginBottom="10dp"
                            android:alpha="0.5"
                            android:src="@drawable/ic_remote" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:paddingStart="24dp"
                            android:paddingEnd="24dp"
                            android:text="Faire glisser pour déplacer\ntaper pour cliquer"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />

                    </LinearLayout>

                </FrameLayout>

            </FrameLayout>

            <!-- Onglet Clavier : remplace le texte du champ actuellement sélectionné
                 sur l'appareil ciblé (recherche, identifiant...), même mécanisme que
                 la PWA (text_set, cf. IptvApplication.setRemoteText). -->
            <LinearLayout
                android:id="@+id/keyboard_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/et_keyboard"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_remote_card"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:hint="Tapez ici…"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="16sp"
                    android:inputType="text"
                    android:imeOptions="actionDone"
                    android:singleLine="true"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Remplace le texte du champ actuellement sélectionné sur l'appareil ciblé (recherche, identifiant...)."
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Onglets bas : D-pad / Souris / Clavier (parité PWA) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/bg_nav"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tab_dpad"
            style="@style/RemoteTab"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_remote_tab_active"
            android:text="D-pad"
            android:textColor="@color/accent" />

        <TextView
            android:id="@+id/tab_mouse"
            style="@style/RemoteTab"
            android:layout_marginEnd="8dp"
            android:text="Souris"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/tab_keyboard"
            style="@style/RemoteTab"
            android:text="Clavier"
            android:textColor="@color/text_secondary" />

    </LinearLayout>

</LinearLayout>
