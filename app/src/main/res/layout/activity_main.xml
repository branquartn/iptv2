<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:clipChildren="false"
    android:clipToPadding="false">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_home_bg" />

    <!-- Barre du haut -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_nicotv_wordmark"
            android:scaleType="fitStart" />

        <!-- Reprendre la lecture -->
        <FrameLayout
            android:id="@+id/btn_resume"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:focusable="true"
            android:clickable="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_pwa_restart"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tv_resume_count"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:minWidth="18dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-5dp"
                android:layout_marginEnd="-5dp"
                android:background="@drawable/bg_badge_resume"
                android:gravity="center"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textColor="@android:color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:elevation="10dp" />

            <com.nicotv.iptv2.ui.common.RotatingBorderView
                android:id="@+id/btn_resume_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:circular="true"
                app:borderColor="@android:color/white"
                android:visibility="invisible" />
        </FrameLayout>

        <!-- Recherche -->
        <FrameLayout
            android:id="@+id/btn_search"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:focusable="true"
            android:clickable="true"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_search"
                app:tint="@color/text_primary" />

            <com.nicotv.iptv2.ui.common.RotatingBorderView
                android:id="@+id/btn_search_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:circular="true"
                app:borderColor="@android:color/white"
                android:visibility="invisible" />
        </FrameLayout>

        <!-- Favoris -->
        <FrameLayout
            android:id="@+id/btn_favorites"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:focusable="true"
            android:clickable="true"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_star"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tv_favorites_count"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:minWidth="18dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-5dp"
                android:layout_marginEnd="-5dp"
                android:background="@drawable/bg_badge_resume"
                android:gravity="center"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textColor="@android:color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:elevation="10dp"
                android:visibility="gone" />

            <com.nicotv.iptv2.ui.common.RotatingBorderView
                android:id="@+id/btn_favorites_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:circular="true"
                app:borderColor="@android:color/white"
                android:visibility="invisible" />
        </FrameLayout>

        <!-- Réglages (profil actif, cache images/playlist/EPG) -->
        <FrameLayout
            android:id="@+id/btn_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:focusable="true"
            android:clickable="true"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_settings"
                app:tint="@color/text_primary" />

            <com.nicotv.iptv2.ui.common.RotatingBorderView
                android:id="@+id/btn_settings_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:circular="true"
                app:borderColor="@android:color/white"
                android:visibility="invisible" />
        </FrameLayout>
    </LinearLayout>

    <!-- 3 tuiles d'accueil : Live / Films / Séries -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:padding="12dp">

        <FrameLayout
            android:id="@+id/card_live"
            android:layout_width="220dp"
            android:layout_height="188dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/bg_hub_card"
            android:focusable="true"
            android:focusableInTouchMode="true">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/gradient_hub" />

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="18dp"
                android:alpha="0.85"
                android:src="@drawable/ic_live"
                app:tint="@android:color/white" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="22dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_live"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_live_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:alpha="0.9" />
            </LinearLayout>

            <com.nicotv.iptv2.ui.common.RotatingBorderView
                android:id="@+id/focus_ring_live"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:borderColor="@android:color/white"
                app:cornerRadius="16dp"
                android:visibility="invisible" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/card_films"
            android:layout_width="220dp"
            android:layout_height="188dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/bg_hub_card"
            android:focusable="true"
            android:focusableInTouchMode="true">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.5"
                android:scaleType="centerCrop"
                android:src="@drawable/hub_films" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/gradient_hub" />

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="18dp"
                android:alpha="0.85"
                android:src="@drawable/ic_movies"
                app:tint="@android:color/white" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="22dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_movies"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_films_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:alpha="0.9" />
            </LinearLayout>

            <com.nicotv.iptv2.ui.common.RotatingBorderView
                android:id="@+id/focus_ring_films"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:borderColor="@android:color/white"
                app:cornerRadius="16dp"
                android:visibility="invisible" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/card_series"
            android:layout_width="220dp"
            android:layout_height="188dp"
            android:background="@drawable/bg_hub_card"
            android:focusable="true"
            android:focusableInTouchMode="true">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.5"
                android:scaleType="centerCrop"
                android:src="@drawable/hub_series" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/gradient_hub" />

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="18dp"
                android:alpha="0.85"
                android:src="@drawable/ic_series"
                app:tint="@android:color/white" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="22dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_series"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_series_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:alpha="0.9" />
            </LinearLayout>

            <com.nicotv.iptv2.ui.common.RotatingBorderView
                android:id="@+id/focus_ring_series"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:borderColor="@android:color/white"
                app:cornerRadius="16dp"
                android:visibility="invisible" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:alpha="0.6" />

</FrameLayout>
