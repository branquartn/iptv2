<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Fond plein écran aléatoire (film/série du catalogue chargé), stable pour
         la session — même principe que NicoTV (MainActivity.maybeSetHomeBg). -->
    <ImageView
        android:id="@+id/iv_home_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.26" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_home_bg" />

    <!-- Barre du haut -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_nicotv_wordmark"
            android:scaleType="fitStart" />

        <!-- Reprendre la lecture -->
        <FrameLayout
            android:id="@+id/btn_resume"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:focusable="true"
            android:clickable="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_pwa_restart"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tv_resume_count"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:minWidth="18dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-5dp"
                android:layout_marginEnd="-5dp"
                android:background="@drawable/bg_badge_resume"
                android:gravity="center"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textColor="@android:color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:elevation="10dp" />

            <com.nicotv.iptv2.ui.common.RotatingBorderView
                android:id="@+id/btn_resume_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:circular="true"
                app:borderColor="@android:color/white"
                android:visibility="invisible" />
        </FrameLayout>

        <!-- Recherche -->
        <FrameLayout
            android:id="@+id/btn_search"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:focusable="true"
            android:clickable="true"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_search"
                app:tint="@color/text_primary" />

            <com.nicotv.iptv2.ui.common.RotatingBorderView
                android:id="@+id/btn_search_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:circular="true"
                app:borderColor="@android:color/white"
                android:visibility="invisible" />
        </FrameLayout>

        <!-- Favoris -->
        <FrameLayout
            android:id="@+id/btn_favorites"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:focusable="true"
            android:clickable="true"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_star"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tv_favorites_count"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:minWidth="18dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-5dp"
                android:layout_marginEnd="-5dp"
                android:background="@drawable/bg_badge_resume"
                android:gravity="center"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textColor="@android:color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:elevation="10dp"
                android:visibility="gone" />

            <com.nicotv.iptv2.ui.common.RotatingBorderView
                android:id="@+id/btn_favorites_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:circular="true"
                app:borderColor="@android:color/white"
                android:visibility="invisible" />
        </FrameLayout>

        <!-- Réglages (profil actif, cache images/playlist) -->
        <FrameLayout
            android:id="@+id/btn_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:focusable="true"
            android:clickable="true"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_settings"
                app:tint="@color/text_primary" />

            <com.nicotv.iptv2.ui.common.RotatingBorderView
                android:id="@+id/btn_settings_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:circular="true"
                app:borderColor="@android:color/white"
                android:visibility="invisible" />
        </FrameLayout>
    </LinearLayout>

    <!-- 3 tuiles d'accueil : Live / Films / Séries -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:padding="12dp">

        <FrameLayout
            android:id="@+id/card_live"
            android:layout_width="280dp"
            android:layout_height="188dp"
            android:layout_marginEnd="18dp"
            android:focusable="true"
            android:focusableInTouchMode="true">

            <!-- Image collage fournie par l'utilisateur (29/08/2026, demande
                 explicite — remplace la mosaïque de 6 logos séparés) : 3:2
                 (1536×1024), carte élargie à 280dp (188×1.5) pour coller à ce
                 ratio et limiter le rognage en centerCrop. Pas de dégradé
                 dessus (demande explicite) : l'image a déjà son propre fond
                 sombre, le texte "Chaînes" reste lisible tel quel. -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/hub_live_collage" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="22dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_live"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.nicotv.iptv2.ui.common.RotatingBorderView
                android:id="@+id/focus_ring_live"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:borderColor="@android:color/white"
                app:cornerRadius="16dp"
                android:visibility="invisible" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/card_films"
            android:layout_width="280dp"
            android:layout_height="188dp"
            android:layout_marginEnd="18dp"
            android:focusable="true"
            android:focusableInTouchMode="true">

            <!-- Image collage générée (29/08/2026, demande explicite "comme
                 Chaînes mais avec des films") — remplace la jaquette/backdrop
                 du catalogue en rotation (MainActivity.loadRotatingHubImage,
                 retiré) : image fixe, plus de dépendance au catalogue. Même
                 traitement que card_live : pleine opacité, pas de dégradé
                 par-dessus, carte élargie à 280dp pour le ratio 3:2. -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/hub_films_collage" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="22dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_movies"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.nicotv.iptv2.ui.common.RotatingBorderView
                android:id="@+id/focus_ring_films"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:borderColor="@android:color/white"
                app:cornerRadius="16dp"
                android:visibility="invisible" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/card_series"
            android:layout_width="280dp"
            android:layout_height="188dp"
            android:focusable="true"
            android:focusableInTouchMode="true">

            <!-- Cf. card_films juste au-dessus : même principe pour les séries
                 (image collage générée, plus de rotation catalogue, pas de
                 dégradé). -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/hub_series_collage" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="22dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_series"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.nicotv.iptv2.ui.common.RotatingBorderView
                android:id="@+id/focus_ring_series"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:borderColor="@android:color/white"
                app:cornerRadius="16dp"
                android:visibility="invisible" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:alpha="0.6" />

</FrameLayout>
