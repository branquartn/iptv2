<?xml version="1.0" encoding="utf-8"?>
<!-- FrameLayout (au lieu du LinearLayout d'origine) : nécessaire pour superposer
     l'anneau blanc tournant (RotatingBorderView) au contenu sans perturber le flux
     vertical. Marge/dimensions inchangées sur ce conteneur racine (déplacées depuis
     l'ancien LinearLayout) pour que l'anneau touche exactement les mêmes bords que
     l'ancien contour statique (ex. le bas des onglets saison pour l'épisode 1). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/episode_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:focusable="true"
    android:nextFocusRight="@id/btn_episode_download"
    android:background="@drawable/bg_episode_item">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Téléchargement local (mode avion) : toujours visible, icône selon l'état -->
        <FrameLayout
            android:id="@+id/btn_episode_download"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusLeft="@id/episode_row"
            android:nextFocusRight="@id/btn_episode_restart"
            android:background="?android:attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/iv_episode_download"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_download"
                app:tint="@color/text_secondary"
                xmlns:app="http://schemas.android.com/apk/res-auto" />

            <ProgressBar
                android:id="@+id/progress_episode_download"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_episode_download_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#6E84FF"
                android:visibility="gone" />

        </FrameLayout>

        <!-- ⟳ Depuis le début : seulement sur un épisode commencé -->
        <FrameLayout
            android:id="@+id/btn_episode_restart"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusLeft="@id/btn_episode_download"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_pwa_restart"
                app:tint="@color/text_secondary"
                xmlns:app="http://schemas.android.com/apk/res-auto" />

        </FrameLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/tv_overview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:ellipsize="end"
        android:maxLines="2"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progress_resume"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progressTint="#4361EE"
        android:visibility="gone" />

    </LinearLayout>

    <!-- Anneau blanc tournant au focus (remplace l'ancien contour statique de
         bg_episode_item) — match_parent = mêmes bords que la ligne elle-même, donc
         touche le bas des onglets saison quand l'épisode 1 est sélectionné. -->
    <com.nicotv.iptv.ui.common.RotatingBorderView
        android:id="@+id/episode_row_ring"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:circular="false"
        app:cornerRadius="0dp"
        app:borderColor="@android:color/white"
        android:visibility="invisible" />

</FrameLayout>
