<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="54dp"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    android:padding="3dp"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:focusable="true"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Anneau de focus TÉLÉCOMMANDE : entoure SEULEMENT la photo ronde (pas tout
         l'item) — cf. CastAdapter, qui bascule sa visibilité au lieu d'un zoom. -->
    <FrameLayout
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.nicotv.iptv2.ui.common.RotatingBorderView
            android:id="@+id/cast_focus_ring"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="center"
            app:circular="true"
            android:visibility="invisible" />

        <androidx.cardview.widget.CardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/bg_card"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <!-- TopCropImageView : cadrage tête-en-haut fait au dessin (matrice),
                 pas par une Transformation Coil (bugs de timing au 1er affichage).
                 Le rond est déjà géré par la CardView (cornerRadius). -->
            <com.nicotv.iptv2.ui.common.TopCropImageView
                android:id="@+id/iv_cast_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </androidx.cardview.widget.CardView>

    </FrameLayout>

    <TextView
        android:id="@+id/tv_cast_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/text_primary"
        android:textSize="9sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_cast_character"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/text_secondary"
        android:textSize="8sp" />

</LinearLayout>
