<?xml version="1.0" encoding="utf-8"?>
<!-- Rond qui tourne pendant le téléchargement de la mise à jour (29/08/2026,
     demande explicite) — avant, seul un Toast furtif signalait le début du
     téléchargement (DownloadManager système, aucune notif visible ensuite,
     VISIBILITY_HIDDEN), pas de retour visuel pendant l'attente. Même style
     que dialog_quit.xml : fond bg_dialog sur la vue elle-même, fenêtre du
     dialogue mise en transparent côté Kotlin (UpdateManager). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog"
    android:gravity="center_horizontal"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingTop="32dp"
    android:paddingBottom="32dp">

    <ProgressBar
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:indeterminateTint="@color/accent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/update_downloading"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
