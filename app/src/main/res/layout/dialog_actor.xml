<?xml version="1.0" encoding="utf-8"?>
<!-- Un seul scroll pour tout (photo+bio+grille), comme la PWA (#ac-body) — pas de
     grille qui scrolle "à part" dans son propre cadre. MaxHeightScrollView :
     wrap_content jusqu'à 85 % de l'écran (un acteur à 2 films = dialog court),
     plafonné + scroll au-delà — ScrollView standard ignore android:maxHeight,
     et une fenêtre à hauteur FIXE laissait une grande carte à moitié vide. -->
<com.nicotv.iptv2.ui.common.MaxHeightScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/actor_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never"
    android:scrollbars="none">

<LinearLayout
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- En-tête custom (titre + ✕) : mobile seulement (GONE par défaut, montré en
         Kotlin), même mécanisme que dialog_work_preview.xml — remplace le titre/
         bouton OK de l'AlertDialog. TV : builder garde setTitle/setNegativeButton. -->
    <LinearLayout
        android:id="@+id/actor_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_actor_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_actor_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/text_secondary"
            android:textSize="18sp"
            android:focusable="true"
            android:clickable="true" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <androidx.cardview.widget.CardView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginEnd="14dp"
            app:cardCornerRadius="44dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/bg_card">

            <com.nicotv.iptv2.ui.common.TopCropImageView
                android:id="@+id/iv_actor_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tv_actor_bio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="6"
            android:ellipsize="end"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:lineSpacingMultiplier="1.3" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_filmo_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/title_filmography"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/progress_actor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="4dp" />

    <!-- Grille verticale (GridLayoutManager posé en code) — comme .actor-grid
         côté PWA. Hauteur wrap_content : scrolle avec le reste via le
         ScrollView parent (rv.isNestedScrollingEnabled = false en Kotlin).
         WrapHeightRecyclerView (pas RecyclerView standard) : mesure forcée en
         UNSPECIFIED, sinon le wrap_content reste bloqué sur la mesure initiale
         (contenu quasi vide, chargé async après) → 1 seule rangée visible. -->
    <com.nicotv.iptv2.ui.common.WrapHeightRecyclerView
        android:id="@+id/rv_actor_filmography"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipChildren="false"
        android:clipToPadding="false" />

</LinearLayout>
</com.nicotv.iptv2.ui.common.MaxHeightScrollView>
