<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Mise à jour automatique (téléchargement + installation de l'APK) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.DOWNLOAD_WITHOUT_NOTIFICATION" />

    <!-- TV & Fire TV requirements -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="true" />

    <application
        android:name=".IptvApplication"
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/ic_launcher"
        android:logo="@drawable/banner"
        android:isGame="false"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.IPTV"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Configuration de la source (pas de login) -->
        <activity
            android:name=".ui.setup.SetupActivity"
            android:banner="@drawable/banner"
            android:theme="@style/Theme.IPTV.Splash"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustPan"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lanceur Android TV / Fire TV : alias dédié (bannière 16:9). -->
        <activity-alias
            android:name=".LeanbackLauncherAlias"
            android:targetActivity=".ui.setup.SetupActivity"
            android:banner="@drawable/banner"
            android:icon="@drawable/banner"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ui.main.MainActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize"
            android:exported="false" />

        <activity
            android:name=".ui.live.LiveActivity"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustPan"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize"
            android:exported="false" />

        <activity
            android:name=".ui.movies.MoviesActivity"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustPan"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize"
            android:exported="false" />

        <activity
            android:name=".ui.series.SeriesActivity"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustPan"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize"
            android:exported="false" />

        <activity
            android:name=".ui.series.SeriesDetailActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize"
            android:exported="false" />

        <activity
            android:name=".ui.favorites.FavoritesActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize"
            android:exported="false" />

        <activity
            android:name=".ui.search.SearchActivity"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustPan"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize"
            android:exported="false" />

        <activity
            android:name=".ui.detail.DetailActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize"
            android:exported="false" />

        <activity
            android:name=".ui.resume.ResumeActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize"
            android:exported="false" />

        <!-- Player -->
        <activity
            android:name=".player.PlayerActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize"
            android:supportsPictureInPicture="true"
            android:exported="false"
            android:theme="@style/Theme.IPTV.Player" />

        <!-- FileProvider pour installer l'APK de mise à jour -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.nicotv.iptv2.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

    </application>

</manifest>
