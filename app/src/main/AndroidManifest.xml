<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Mise à jour automatique (téléchargement + installation de l'APK) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Téléchargements locaux (mode avion) sans notification système (VISIBILITY_HIDDEN,
         l'app a déjà sa propre UI de progression) — permission normale, aucune demande
         runtime nécessaire. -->
    <uses-permission android:name="android.permission.DOWNLOAD_WITHOUT_NOTIFICATION" />

    <!-- TV & Fire TV requirements -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="true" />

    <application
        android:name=".IptvApplication"
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/ic_launcher"
        android:logo="@drawable/banner"
        android:isGame="false"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.IPTV"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Login -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:banner="@drawable/banner"
            android:theme="@style/Theme.IPTV.Splash"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustPan"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize"
            android:exported="true">
            <!-- Lanceur classique (téléphones / tablettes) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lanceur Android TV / Fire TV : alias dédié (séparé du LAUNCHER classique
             pour que le launcher TV utilise bien le banner 16:9 et non l'icône). -->
        <activity-alias
            android:name=".LeanbackLauncherAlias"
            android:targetActivity=".ui.login.LoginActivity"
            android:banner="@drawable/banner"
            android:icon="@drawable/banner"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Main -->
        <activity
            android:name=".ui.main.MainActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize"
            android:exported="false" />

        <!-- Télécommande : pilote une autre session du même compte (D-pad + lecteur) -->
        <activity
            android:name=".ui.remote.RemoteControlActivity"
            android:screenOrientation="unspecified"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize"
            android:exported="false" />

        <!-- Films (mur d'affiches) -->
        <activity
            android:name=".ui.movies.MoviesActivity"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustPan"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize"
            android:exported="false" />

        <!-- Séries (mur d'affiches) -->
        <activity
            android:name=".ui.series.SeriesActivity"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustPan"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize"
            android:exported="false" />

        <!-- Détail d'une série : liste saisons/épisodes -->
        <activity
            android:name=".ui.series.SeriesDetailActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize"
            android:exported="false" />

        <!-- Favoris -->
        <activity
            android:name=".ui.favorites.FavoritesActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize"
            android:exported="false" />

        <!-- Recherche TMDb -->
        <activity
            android:name=".ui.search.SearchActivity"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustPan"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize"
            android:exported="false" />

        <!-- Gestion des comptes (admin) -->
        <activity
            android:name=".ui.users.UsersActivity"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustPan"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize"
            android:exported="false" />

        <!-- Detail -->
        <activity
            android:name=".ui.detail.DetailActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize"
            android:exported="false" />

        <!-- Reprendre la lecture -->
        <activity
            android:name=".ui.resume.ResumeActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize"
            android:exported="false" />

        <!-- Téléchargements (mode avion) -->
        <activity
            android:name=".ui.downloads.DownloadsActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize"
            android:exported="false" />

        <!-- Player -->
        <activity
            android:name=".player.PlayerActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize"
            android:supportsPictureInPicture="true"
            android:exported="false"
            android:theme="@style/Theme.IPTV.Player" />

        <!-- FileProvider pour installer l'APK de mise à jour -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.nicotv.iptv2.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

    </application>

</manifest>
